{$KAPOJ_SITE_ADDRESS::80} {
	{$KAPOJ_TLS_DIRECTIVE}
	encode zstd gzip

	@backend path /api/* /health
	handle @backend {
		reverse_proxy server:8080
	}

	# Hashed build output is immutable. Missing files must stay 404 instead of
	# falling back to index.html, which browsers reject as a module MIME type.
	handle /assets/* {
		root * /srv
		header {
			Cache-Control "public, max-age=31536000, immutable"
			match status 2xx
		}
		file_server
	}

	# The SPA entry and client-side routes must revalidate so a deploy is picked
	# up on the next navigation or refresh.
	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache"
		file_server
	}
}
