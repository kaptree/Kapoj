# KAPOJ 统一配置文件模板
#
# 复制为 .env 后填写真实值：
#   cp .env.example .env
#   chmod 600 .env
#
# Docker Compose 会自动读取仓库根目录的 .env；Server/Judge 通过 env_file 读取同一文件。
# 直接运行 go run 时可设置 KAPOJ_CONFIG_FILE=.env（非空环境变量优先于文件内容）。
# 不要把 .env 提交到 Git。

# ---------- PostgreSQL ----------
# Postgres 容器和 Server/Judge 共用这一组账号。
# 首次初始化后再改账号/密码，需要同时修改数据库内已有角色/密码，否则连接失败。
POSTGRES_USER=kapoj
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=kapoj
# Compose 内数据库主机为 postgres；本地 go run 时覆盖为 localhost。
KAPOJ_DB_HOST=postgres
KAPOJ_DB_PORT=5432
# 如需完整覆盖连接串（优先于 POSTGRES_* + KAPOJ_DB_HOST/PORT）：
# KAPOJ_DATABASE_URL=postgres://kapoj:change-me-postgres@postgres:5432/kapoj?sslmode=disable

# ---------- Redis ----------
KAPOJ_REDIS_ADDR=redis:6379
# 本机 go run 时覆盖为 localhost:6380。

# ---------- MinIO ----------
# Postgres 之外的组件默认账号也统一放在这里。首次启动前设置好；
# 已初始化的 MinIO 数据卷修改 root 账号后需同步验证/重建访问凭证。
MINIO_ROOT_USER=kapoj
MINIO_ROOT_PASSWORD=change-me-minio
# Server/Judge 在 KAPOJ_MINIO_ACCESS_KEY/SECRET_KEY 为空时自动使用上面的 root 账号。
KAPOJ_MINIO_ENDPOINT=minio:9000
KAPOJ_MINIO_BUCKET=kapoj
KAPOJ_MINIO_BACKUP_BUCKET=kapoj-backups
KAPOJ_MINIO_USE_SSL=false
KAPOJ_MINIO_AUTO_CREATE_BUCKET=true
# 生产环境使用外部 MinIO/S3 时可显式覆盖：
# KAPOJ_MINIO_ACCESS_KEY=
# KAPOJ_MINIO_SECRET_KEY=
# KAPOJ_MINIO_REGION=

# ---------- 存储与备份 ----------
KAPOJ_STORAGE_BACKEND=minio
# MinIO 模式不使用；直接运行 local 回退时使用。
# Compose 未挂载该目录，如需在容器内切到 local 后端，请自行添加持久化卷。
KAPOJ_STORAGE_DIR=/data
# 仅 local 后端生效；MinIO 模式忽略。
KAPOJ_REQUIRE_PERSISTENT_STORAGE=true
# 仅 local 后端的备份包目录；MinIO 模式使用 KAPOJ_MINIO_BACKUP_BUCKET。
# KAPOJ_BACKUP_DIR=
KAPOJ_BACKUP_MAX_UPLOAD_BYTES=2147483648
KAPOJ_BACKUP_MAX_UNCOMPRESSED_BYTES=21474836480
KAPOJ_BACKUP_MAX_ENTRIES=200000

# ---------- Server ----------
KAPOJ_HTTP_ADDR=:8080
# 至少 32 字节；生产环境必须替换。
KAPOJ_JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
KAPOJ_ACCESS_TOKEN_TTL=15m
KAPOJ_REFRESH_TOKEN_TTL=168h
KAPOJ_SUBMIT_COOLDOWN=3s
KAPOJ_GAME_CONCURRENCY=2
KAPOJ_MAX_EQUIPPED_BADGES=3
KAPOJ_RATING_SCAN_INTERVAL=60s
KAPOJ_RATING_JUDGE_GRACE=10m
KAPOJ_TRUSTED_PROXIES=

# AI 用户 Key 的 AES-256-GCM 加密密钥（base64 32 字节）。
# 生成：openssl rand -base64 32
# 配置后后台 AI 密钥板块只读，轮换需修改本文件并重启。
KAPOJ_AI_ENCRYPTION_KEY=
KAPOJ_AI_REQUEST_TIMEOUT=45s
KAPOJ_AI_COOLDOWN=2s

# SMTP 密码的 AES-256-GCM 加密密钥（base64 32 字节）。
# 生成：openssl rand -base64 32
KAPOJ_MAIL_ENCRYPTION_KEY=
KAPOJ_MAIL_TIMEOUT=20s

# 兼容旧版本的密钥文件回退（配置文件有密钥时不使用；仅直接运行可用，Compose 不挂载密钥目录）：
# KAPOJ_AI_KEY_FILE=data/ai.key
# KAPOJ_MAIL_KEY_FILE=data/mail.key

# ---------- Judge ----------
KAPOJ_JUDGE_CONCURRENCY=2
KAPOJ_JUDGE_INSTANCE=judge-1
KAPOJ_JUDGE_DOCKER=docker
KAPOJ_JUDGE_CPP_IMAGE=gcc:14
KAPOJ_JUDGE_PYTHON_IMAGE=python:3.12-slim
KAPOJ_JUDGE_JAVA_IMAGE=eclipse-temurin:21-jdk
KAPOJ_JUDGE_GO_IMAGE=golang:1.26

# ---------- 集成测试（仅宿主机测试读取） ----------
KAPOJ_TEST_DATABASE_URL=postgres://kapoj:change-me-postgres@localhost:5433/kapoj_test?sslmode=disable
