# 后端配置（apps/server 读取 KAPOJ_ 前缀的环境变量）
KAPOJ_HTTP_ADDR=:8080
KAPOJ_DATABASE_URL=postgres://kapoj:kapoj@localhost:5433/kapoj?sslmode=disable
# docker compose 中的 Redis 映射到宿主机 6380 端口，避免与本机 Redis 冲突
KAPOJ_REDIS_ADDR=localhost:6380
# 至少 32 字节，生产环境务必替换
KAPOJ_JWT_SECRET=change-me-to-a-random-string-of-32-bytes-or-more
KAPOJ_ACCESS_TOKEN_TTL=15m
KAPOJ_REFRESH_TOKEN_TTL=168h
# 同一用户两次提交之间的最小间隔
KAPOJ_SUBMIT_COOLDOWN=3s
# 测试数据与 checker 的本地存储目录。必须是绝对路径，server 与 judge 使用同一个值
KAPOJ_STORAGE_DIR=/absolute/path/to/kapoj/apps/server/data

# 评测服务（apps/judge）专用
KAPOJ_JUDGE_CONCURRENCY=2
# 同一实例的容器清理标签；多实例部署时每个实例必须不同（默认取主机名）
# KAPOJ_JUDGE_INSTANCE=judge-1
# KAPOJ_JUDGE_DOCKER=docker
# KAPOJ_JUDGE_CPP_IMAGE=gcc:14
# KAPOJ_JUDGE_PYTHON_IMAGE=python:3.12-slim
# KAPOJ_JUDGE_JAVA_IMAGE=eclipse-temurin:21-jdk
# KAPOJ_JUDGE_GO_IMAGE=golang:1.26

# 集成测试使用的数据库
KAPOJ_TEST_DATABASE_URL=postgres://kapoj:kapoj@localhost:5433/kapoj_test?sslmode=disable

# AI 辅助（apps/server）。配置 KAPOJ_AI_ENCRYPTION_KEY 后才挂载 /api/ai/* 路由；
# 不配置时后端正常启动，只是 AI 路由不存在（404）。密钥必须是 base64 编码的 32 字节，
# 生成方式：openssl rand -base64 32
# KAPOJ_AI_ENCRYPTION_KEY=
# AI 上游请求超时（默认 45s）
KAPOJ_AI_REQUEST_TIMEOUT=45s
# 同一用户两次 AI 调用（补全/格式化/优化/首次生成提示）之间的最小间隔（默认 2s）
KAPOJ_AI_COOLDOWN=2s
